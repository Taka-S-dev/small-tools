<Project Sdk="Microsoft.NET.Sdk">

  <!--
    コマンドラインから使う版（DocsToPdfCli.exe）。画面を出さず、終わるまで待ち、結果を終了コードで返す。
    バッチファイル、PowerShell、タスクスケジューラーから使う。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows 10 の新しい API（画面版のプレビューで使う）は要らないので、その対応部品（約 25MB）を含めない -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DocsToPdfCli</AssemblyName>
    <RootNamespace>DocsToPdf.Cli</RootNamespace>
    <Product>Docs to PDF</Product>
    <Version>2.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocsToPdf.Core\DocsToPdf.Core.csproj" />
    <!-- .NET の標準的なコマンドライン解析（ヘルプ、入力の検査、Ctrl+C での中止を受け持つ）。MIT -->
    <PackageReference Include="System.CommandLine" Version="2.0.6" />
  </ItemGroup>

</Project>
